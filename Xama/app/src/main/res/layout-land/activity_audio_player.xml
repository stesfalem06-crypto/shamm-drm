<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Blurred artwork backdrop -->
    <ImageView
        android:id="@+id/audioBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:importantForAccessibility="no"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/audio_backdrop_scrim"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton android:id="@+id/audioClose" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="9dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                android:src="@drawable/ic_expand_more" app:tint="@color/text_primary" android:contentDescription="Close"/>
            <TextView style="@style/Text.Overline" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center" android:textColor="@color/text_secondary"
                android:text="Now playing"/>
            <ImageButton android:id="@+id/audioMore" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                android:src="@drawable/ic_more_vert" app:tint="@color/text_primary" android:contentDescription="More"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">

                <androidx.cardview.widget.CardView
                    android:id="@+id/audioArtCard"
                    android:layout_width="@dimen/audio_art_size"
                    android:layout_height="@dimen/audio_art_size"
                    android:layout_gravity="center"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="16dp"
                    app:cardBackgroundColor="@color/bg_elevated">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/art_placeholder">
                        <ImageView android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center"
                            android:src="@drawable/ic_music" android:alpha="0.85" android:importantForAccessibility="no"/>
                        <ImageView android:id="@+id/audioArt" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop" android:contentDescription="Album art"/>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView android:id="@+id/audioTitle" style="@style/Text.Display" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="22sp" android:maxLines="1" android:ellipsize="marquee"
                android:singleLine="true" android:marqueeRepeatLimit="marquee_forever"/>
            <TextView android:id="@+id/audioArtist" style="@style/Text.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp"
                android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end"/>

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/audioTimeBar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="18dp"
                app:bar_height="4dp"
                app:scrubber_enabled_size="14dp"
                app:scrubber_dragged_size="20dp"
                app:touch_target_height="32dp"
                app:played_color="@color/accent"
                app:scrubber_color="#FFFFFF"
                app:buffered_color="#40FFFFFF"
                app:unplayed_color="#26FFFFFF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/audioPosition" style="@style/Text.Caption" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0:00"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/audioDuration" style="@style/Text.Caption" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0:00"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center">
                <ImageButton android:id="@+id/audioShuffle" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                    android:src="@drawable/ic_shuffle" app:tint="@color/text_secondary" android:contentDescription="Shuffle"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/audioPrev" android:layout_width="56dp" android:layout_height="56dp"
                    android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                    android:src="@drawable/ic_skip_prev" app:tint="@color/text_primary" android:contentDescription="Previous"/>
                <ImageButton android:id="@+id/audioPlayPause" android:layout_width="76dp" android:layout_height="76dp"
                    android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:padding="20dp"
                    android:scaleType="fitCenter" android:background="@drawable/player_play_bg" android:elevation="6dp"
                    android:src="@drawable/ic_play" android:contentDescription="Play or pause"/>
                <ImageButton android:id="@+id/audioNext" android:layout_width="56dp" android:layout_height="56dp"
                    android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                    android:src="@drawable/ic_skip_next" app:tint="@color/text_primary" android:contentDescription="Next"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <ImageButton android:id="@+id/audioRepeat" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:scaleType="fitCenter" android:background="@drawable/player_btn_ripple"
                    android:src="@drawable/ic_repeat" app:tint="@color/text_secondary" android:contentDescription="Repeat"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/audioSpeed" android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:minWidth="64dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/btn_secondary" android:textColor="@color/text_primary" android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" android:text="1x" android:contentDescription="Playback speed"/>
                <TextView android:id="@+id/audioSleep" android:layout_width="wrap_content" android:layout_height="36dp"
                    android:layout_marginStart="10dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:background="@drawable/btn_secondary" android:textColor="@color/text_primary" android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" android:drawableStart="@drawable/ic_timer_small"
                    android:drawablePadding="6dp" android:text="Sleep" android:contentDescription="Sleep timer"/>
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
