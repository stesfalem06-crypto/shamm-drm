<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hero_height"
    android:layout_marginBottom="22dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_elevated"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView
            android:id="@+id/heroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_placeholder"
            android:contentDescription="Featured"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_scrim"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/heroKicker"
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Featured"/>
            <TextView
                android:id="@+id/heroTitle"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="22sp"
                android:maxLines="2"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/heroMeta"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/heroPlay"
                    style="@style/PillButton.Primary"
                    android:layout_height="40dp"
                    android:drawableStart="@drawable/ic_play"
                    android:paddingStart="16dp"
                    android:text="Watch now"/>
                <TextView
                    android:id="@+id/heroFolder"
                    style="@style/PillButton.Secondary"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:text="Open folder"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
