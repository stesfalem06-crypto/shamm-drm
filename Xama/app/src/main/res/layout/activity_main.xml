<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_panel">
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xama"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/videoCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search"/>
        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Search movies &amp; folders…"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Content area: home grid / folders list / folder detail -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"/>

        <!-- Folder detail back bar -->
        <LinearLayout
            android:id="@+id/folderBackBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/bg_dark"
            android:visibility="gone">
            <TextView
                android:id="@+id/btnBackFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Folders"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="8dp"/>
            <TextView
                android:id="@+id/folderDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">
            <TextView
                android:layout_width="72dp" android:layout_height="72dp"
                android:gravity="center" android:text="▶" android:textSize="32sp"
                android:textColor="@color/accent" android:background="@drawable/play_circle_bg"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Nothing here yet"
                android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Allow video access to browse folders on this phone.\nProtected titles appear after a shop USB transfer."
                android:textColor="@color/text_muted" android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_panel"
        android:elevation="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/navHomeIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⌂" android:textSize="20sp" android:textColor="@color/accent"/>
            <TextView android:id="@+id/navHomeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textSize="11sp" android:textColor="@color/accent" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navFolders" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/navFoldersIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▣" android:textSize="20sp" android:textColor="@color/text_muted"/>
            <TextView android:id="@+id/navFoldersLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Folders" android:textSize="11sp" android:textColor="@color/text_muted"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProtected" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/navProtectedIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="★" android:textSize="20sp" android:textColor="@color/text_muted"/>
            <TextView android:id="@+id/navProtectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Protected" android:textSize="11sp" android:textColor="@color/text_muted"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
