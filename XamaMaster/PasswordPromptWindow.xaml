<Window x:Class="XamaMaster.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owner password" Height="200" Width="420"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="PromptLabel" Text="Enter owner password:" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
        <PasswordBox x:Name="PasswordInput" Height="36" Padding="10,8"
                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}"/>
        <TextBlock x:Name="ErrorText" Foreground="#F87171" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
