<Window x:Class="XamaMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xama Master" Height="700" Width="1080"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}" Margin="0,6,10,0"/>
                <TextBlock Text="Xama Master" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="  ·  encrypt &amp; price your catalog" FontSize="16" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="4,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Settlement…" Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                    VerticalAlignment="Top" Click="OpenSettlement_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Video title" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <TextBox x:Name="TitleBox" Height="38" ToolTip="Leave blank to use the file name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Token price" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <TextBox x:Name="PriceBox" Height="38" Text="1"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,22,12,0" Orientation="Horizontal">
                    <CheckBox x:Name="VerticalCheck" Content="Vertical (Reels)"
                              VerticalAlignment="Center"
                              ToolTip="Mark vertical clips so phones open them in the swipe feed"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Choose file…" Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                        Margin="0,20,10,0" Height="38" Click="ChooseFile_Click"/>
                <Button Grid.Column="4" x:Name="EncryptButton" Content="Encrypt &amp; Add" Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0" Height="38" Click="Encrypt_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,12" x:Name="ProgressPanel" Visibility="Collapsed">
            <ProgressBar x:Name="EncryptProgress" Height="6" IsIndeterminate="True"
                         Background="#2A2A3A" Foreground="{StaticResource Accent}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressLabel" Text="Encrypting…" Foreground="{StaticResource TextMuted}"
                       FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Border Background="{StaticResource BgPanel}" CornerRadius="14" Padding="4">
                <ListView x:Name="LibraryList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextPrimary}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="340" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Price" Width="80" DisplayMemberBinding="{Binding TokenPrice}"/>
                            <GridViewColumn Header="Format" Width="100" DisplayMemberBinding="{Binding FormatLabel}"/>
                            <GridViewColumn Header="Video ID" Width="240" DisplayMemberBinding="{Binding VideoId}"/>
                            <GridViewColumn Header="Encrypted" Width="180" DisplayMemberBinding="{Binding EncryptedAtUtc}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <Border x:Name="LibraryEmpty" Background="{StaticResource BgPanel}" CornerRadius="14"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="No videos yet" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a video file, set a title and token price, then click Encrypt &amp; Add.&#10;Encrypted packages appear here ready to copy to shops."
                               Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" MaxWidth="420" LineHeight="22"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{StaticResource TextMuted}"
                   Margin="0,16,0,0" Text="Ready." TextWrapping="Wrap"/>
    </Grid>
</Window>
