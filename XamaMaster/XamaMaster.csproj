<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XamaMaster</AssemblyName>

    <!-- Produces one portable .exe with no separate .dll files to distribute,
         and no .NET install required on the machine that runs it - matters
         since this is an early-stage, unsigned, no-installer build. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <!-- shamm_crypto.dll from Phase 1, dropped in next to the exe at build time
         by the GitHub Actions workflow - see build-xama-master.yml -->
    <None Include="shamm_crypto.dll" Condition="Exists('shamm_crypto.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
