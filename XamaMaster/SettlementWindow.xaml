<Window x:Class="XamaMaster.SettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settlement" Height="600" Width="820"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settle a shop visit" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Load ledger export (USB)..." Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                    Margin="0,0,10,0" Click="LoadExport_Click"/>
            <TextBlock x:Name="ShopLabel" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="4">
            <ListView x:Name="EntriesList" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextPrimary}"
                      SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Video" Width="260" DisplayMemberBinding="{Binding VideoTitle}"/>
                        <GridViewColumn Header="Device" Width="180" DisplayMemberBinding="{Binding DeviceModel}"/>
                        <GridViewColumn Header="Tokens" Width="90" DisplayMemberBinding="{Binding TokenPrice}"/>
                        <GridViewColumn Header="Sent" Width="180" DisplayMemberBinding="{Binding SentAtUtc}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="TotalText" Grid.Row="3" Foreground="{StaticResource Accent}"
                   FontWeight="Bold" FontSize="16" Margin="0,14,0,10" Text="Total: 0 tokens"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Settle selected (all if none selected)" Style="{StaticResource PrimaryButton}"
                    Click="Settle_Click"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" Margin="16,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
