<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XSeller</AssemblyName>
    <ApplicationIcon>Assets\xseller.ico</ApplicationIcon>
    <Product>X Seller</Product>
    <Company>Shamm</Company>
    <Version>0.5.0</Version>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Startup/perf: precompiled code + dynamic PGO, compressed single file. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="MediaDevices" Version="1.10.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="shamm_crypto.dll" Condition="Exists('shamm_crypto.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <Resource Include="Assets\xseller.ico" Condition="Exists('Assets\xseller.ico')" />
    <!-- adb.exe + its support DLLs are downloaded by the GitHub Actions
         workflow at build time (see build-xseller.yml) and dropped into
         platform-tools/ next to the published exe - you never have to
         install or configure ADB yourself. -->
    <None Include="drivers\install-drivers.cmd" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Bundle signed ADB USB drivers next to the published exe (drivers\). Done here
       rather than in the workflow so no workflow change is needed. Failures only warn. -->
  <Target Name="BundleAdbDrivers" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' And '$(XSellerNoExtra)' != 'true'">
    <PropertyGroup>
      <DrvDir>$(PublishDir)drivers\</DrvDir>
      <DrvTmp>$(IntermediateOutputPath)drvdl\</DrvTmp>
    </PropertyGroup>
    <DownloadFile SourceUrl="https://dl.google.com/android/repository/usb_driver_r13-windows.zip"
                  DestinationFolder="$(DrvTmp)" Retries="3" ContinueOnError="WarnAndContinue" />
    <Unzip SourceFiles="$(DrvTmp)usb_driver_r13-windows.zip" DestinationFolder="$(DrvDir)"
           Condition="Exists('$(DrvTmp)usb_driver_r13-windows.zip')" ContinueOnError="WarnAndContinue" />
    <DownloadFile SourceUrl="https://github.com/koush/adb.clockworkmod.com/releases/download/v1.0.0/UniversalAdbDriverSetup.msi"
                  DestinationFolder="$(DrvDir)" DestinationFileName="UniversalAdbDriverSetup.msi"
                  Retries="3" ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Extra 32-bit (win-x86) build in publish\x86\ for old 32-bit Windows 10 PCs. Done from the
       project because the CI token cannot edit workflow files. Failures only warn; x64 is unaffected. -->
  <Target Name="PublishX86" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == 'win-x64' And '$(XSellerNoExtra)' != 'true'">
    <PropertyGroup>
      <CryptoDir>$(MSBuildProjectDirectory)\..\crypto-core</CryptoDir>
      <DotnetExe Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetExe>
      <DotnetExe Condition="'$(DotnetExe)' == ''">dotnet</DotnetExe>
      <X86Out>$([System.IO.Path]::GetFullPath('$(PublishDir)'))x86</X86Out>
    </PropertyGroup>
    <Exec Command="rustup target add i686-pc-windows-msvc" WorkingDirectory="$(CryptoDir)" ContinueOnError="WarnAndContinue" />
    <Exec Command="cargo build --release --target i686-pc-windows-msvc" WorkingDirectory="$(CryptoDir)" ContinueOnError="WarnAndContinue" />
    <Exec Command="&quot;$(DotnetExe)&quot; publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x86 --self-contained true -o &quot;$(X86Out)&quot; -p:XSellerNoExtra=true"
          ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(CryptoDir)\target\i686-pc-windows-msvc\release\shamm_crypto.dll" DestinationFolder="$(X86Out)"
          Condition="Exists('$(CryptoDir)\target\i686-pc-windows-msvc\release\shamm_crypto.dll')" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="BuildInnoInstallers" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' And '$(XSellerNoExtra)' != 'true'">
    <PropertyGroup>
      <_Pub>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_Pub>
      <_X86>$(_Pub)x86</_X86>
      <_Ps1>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\installer\build-installers.ps1'))</_Ps1>
    </PropertyGroup>
    <!-- Re-copy x64 crypto next to exe in case single-file publish dropped it -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\crypto-core\target\release\shamm_crypto.dll"
          DestinationFolder="$(_Pub)" Condition="Exists('$(MSBuildProjectDirectory)\..\crypto-core\target\release\shamm_crypto.dll')" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\crypto-core\target\x86_64-pc-windows-msvc\release\shamm_crypto.dll"
          DestinationFolder="$(_Pub)" Condition="Exists('$(MSBuildProjectDirectory)\..\crypto-core\target\x86_64-pc-windows-msvc\release\shamm_crypto.dll')" ContinueOnError="WarnAndContinue" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_Ps1)&quot; -App xseller -SourceDir &quot;$(_Pub.TrimEnd('\'))&quot; -X86Dir &quot;$(_X86)&quot;"
          ContinueOnError="WarnAndContinue" />
    <!-- Copy installers into publish\installers for the artifact -->
    <MakeDir Directories="$(_Pub)installers" />
    <ItemGroup>
      <_Setups Include="$(MSBuildProjectDirectory)\..\installer\output\XSeller-Setup-*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_Setups)" DestinationFolder="$(_Pub)installers" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
