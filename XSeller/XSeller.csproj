<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XSeller</AssemblyName>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="MediaDevices" Version="1.10.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="shamm_crypto.dll" Condition="Exists('shamm_crypto.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- adb.exe + its support DLLs are downloaded by the GitHub Actions
         workflow at build time (see build-xseller.yml) and dropped into
         platform-tools/ next to the published exe - you never have to
         install or configure ADB yourself. -->
    <None Include="drivers\install-drivers.cmd" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Bundle signed ADB USB drivers next to the published exe (drivers\). Done here
       rather than in the workflow so no workflow change is needed. Failures only warn. -->
  <Target Name="BundleAdbDrivers" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <DrvDir>$(PublishDir)drivers\</DrvDir>
      <DrvTmp>$(IntermediateOutputPath)drvdl\</DrvTmp>
    </PropertyGroup>
    <DownloadFile SourceUrl="https://dl.google.com/android/repository/usb_driver_r13-windows.zip"
                  DestinationFolder="$(DrvTmp)" Retries="3" ContinueOnError="WarnAndContinue" />
    <Unzip SourceFiles="$(DrvTmp)usb_driver_r13-windows.zip" DestinationFolder="$(DrvDir)"
           Condition="Exists('$(DrvTmp)usb_driver_r13-windows.zip')" ContinueOnError="WarnAndContinue" />
    <DownloadFile SourceUrl="https://github.com/koush/adb.clockworkmod.com/releases/download/v1.0.0/UniversalAdbDriverSetup.msi"
                  DestinationFolder="$(DrvDir)" DestinationFileName="UniversalAdbDriverSetup.msi"
                  Retries="3" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
