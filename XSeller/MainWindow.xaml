<Window x:Class="XSeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Seller" Height="680" Width="1100"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + running debt -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}" Margin="0,4,10,0"/>
                <TextBlock Text="X Seller" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Outstanding: " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DebtText" Text="0 tokens" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search bar (Everything-style: filters as you type) -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Height="42" FontSize="15" Margin="0,0,0,16"
                 Text="" TextChanged="SearchBox_TextChanged"
                 VerticalContentAlignment="Center" Padding="14,0"
                 Tag="Search your video library..."/>

        <!-- Split: library results (left) | connected devices (right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="4">
                <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextPrimary}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="380" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Price" Width="100" DisplayMemberBinding="{Binding TokenPrice}"/>
                            <GridViewColumn Header="Video ID" Width="220" DisplayMemberBinding="{Binding VideoId}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="Connected phones" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,10"/>
                    <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}" Height="360"/>
                    <Button Content="Refresh devices" Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                            Margin="0,10,0,10" Click="RefreshDevices_Click"/>
                    <Button Content="Send selected video" Style="{StaticResource PrimaryButton}"
                            Click="Send_Click"/>
                    <Separator Margin="0,14,0,10" Background="#2A2A3A"/>
                    <TextBlock Text="Settlement" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,10"/>
                    <Button Content="Export for agent (USB)" Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                            Margin="0,0,0,10" Click="ExportForAgent_Click"/>
                    <Button Content="Import settlement" Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                            Click="ImportSettlement_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{StaticResource TextMuted}"
                   Margin="0,16,0,0" Text="Ready."/>
    </Grid>
</Window>
