<Window x:Class="XSeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Seller" Height="720" Width="1140"
        MinHeight="580" MinWidth="960"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + debt -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}" Margin="0,6,10,0"/>
                <TextBlock Text="X Seller" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="ShopNameText" Text="" FontSize="14" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="12,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Outstanding: " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DebtText" Text="0 tokens" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search with visible placeholder overlay -->
        <Grid Grid.Row="1" Margin="0,0,0,14" Height="42">
            <TextBox x:Name="SearchBox" FontSize="15"
                     TextChanged="SearchBox_TextChanged"
                     VerticalContentAlignment="Center" Padding="14,0"
                     Background="{StaticResource BgPanel}"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search your video library…"
                       Foreground="{StaticResource TextMuted}" FontSize="15"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10" x:Name="ProgressPanel" Visibility="Collapsed">
            <ProgressBar Height="6" IsIndeterminate="True"
                         Background="#2A2A3A" Foreground="{StaticResource Accent}" BorderThickness="0"/>
            <TextBlock x:Name="ProgressLabel" Text="Working…" Foreground="{StaticResource TextMuted}"
                       FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Library -->
            <Grid Grid.Column="0">
                <Border Background="{StaticResource BgPanel}" CornerRadius="14" Padding="4">
                    <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimary}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="320" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Price" Width="70" DisplayMemberBinding="{Binding TokenPrice}"/>
                                <GridViewColumn Header="Format" Width="90" DisplayMemberBinding="{Binding FormatLabel}"/>
                                <GridViewColumn Header="Video ID" Width="200" DisplayMemberBinding="{Binding VideoId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
                <Border x:Name="LibraryEmpty" Background="{StaticResource BgPanel}" CornerRadius="14"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <TextBlock Text="Library is empty" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Copy .shammvid + .shammmeta files from Xama Master into&#10;Documents\XSeller\Library, then they will appear here."
                                   Foreground="{StaticResource TextMuted}" TextAlignment="Center" Margin="0,10,0,0"
                                   TextWrapping="Wrap" MaxWidth="360" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Devices + actions -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connected phones" Foreground="{StaticResource TextMuted}"
                               FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="Refresh devices" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,10,0,8" Click="RefreshDevices_Click"/>
                        <Button x:Name="SendButton" Content="Send selected video" Style="{StaticResource PrimaryButton}"
                                Click="Send_Click"/>
                        <Separator Margin="0,14,0,10" Background="#2A2A3A"/>
                        <TextBlock Text="Settlement" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,8"/>
                        <Button Content="Export for agent (USB)" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="ExportForAgent_Click"/>
                        <Button Content="Import settlement" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Click="ImportSettlement_Click"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"/>
                        <Border x:Name="DevicesEmpty" Background="Transparent" IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" Margin="8">
                                <TextBlock Text="No phone detected" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                <TextBlock Text="1. Enable Developer options&#10;2. Turn on USB debugging&#10;3. Plug in and accept the prompt&#10;4. Click Refresh devices"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{StaticResource TextMuted}"
                   Margin="0,14,0,0" Text="Ready." TextWrapping="Wrap"/>
    </Grid>
</Window>
