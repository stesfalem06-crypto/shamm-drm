<Window x:Class="XSeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Seller" Height="760" Width="1200"
        MinHeight="600" MinWidth="980"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="X Seller" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="ShopNameText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                <TextBlock x:Name="IndexCountText" Text="0 indexed" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Outstanding  " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DebtText" Text="0 tokens" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Everything-style search -->
        <Grid Grid.Row="1" Height="48" Margin="0,0,0,12">
            <Border Background="{StaticResource BgPanel}" CornerRadius="12" BorderBrush="#2E2E40" BorderThickness="1"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                     FontSize="16" VerticalContentAlignment="Center" Padding="16,0"
                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search everything — title, path, protected, open…"
                       Foreground="{StaticResource TextMuted}" FontSize="15"
                       VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Filters + progress -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="ChipAll" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="{StaticResource Accent}" MouseLeftButtonUp="ChipAll_Click">
                    <TextBlock Text="All" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <Border x:Name="ChipProtected" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipProtected_Click">
                    <TextBlock Text="Protected" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border x:Name="ChipOpen" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipOpen_Click">
                    <TextBlock Text="Open files" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Orientation="Vertical" Visibility="Collapsed" HorizontalAlignment="Right" Width="280">
                <ProgressBar Height="4" IsIndeterminate="True" BorderThickness="0"
                             Background="#2A2A3A" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProgressLabel" Text="Working…" FontSize="11"
                           Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="2">
                <Grid>
                    <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimary}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Title" Width="320" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding KindLabel}"/>
                                <GridViewColumn Header="Format" Width="70" DisplayMemberBinding="{Binding FormatLabel}"/>
                                <GridViewColumn Header="Price" Width="60" DisplayMemberBinding="{Binding TokenPrice}"/>
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeLabel}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="LibraryEmpty" Text="No matches. Drop .shamm packages into Library or plain videos into Plain / indexed folders."
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="40" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Connected phones" FontSize="13"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="Send to phone" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8" Click="Send_Click" x:Name="SendButton"/>
                        <Button Content="Copy to USB / folder…" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="CopyUsb_Click"/>
                        <Separator Margin="0,6,0,10" Background="#2A2A3A"/>
                        <TextBlock Text="Settlement" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <Button Content="Export ledger (USB)" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="ExportForAgent_Click"/>
                        <Button Content="Import settlement" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="ImportSettlement_Click"/>
                        <Button Content="Add media folder…" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Click="AddFolder_Click"/>
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel x:Name="DevicesEmpty" VerticalAlignment="Center" Margin="4">
                            <TextBlock Text="Waiting for phone…" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="1. Enable Developer options (tap Build number 7×)&#10;2. Turn on USB debugging once&#10;3. Plug in and tap Allow&#10;&#10;X Seller then detects the phone automatically and optimizes the session."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="DeviceBanner" Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Accent}" FontSize="12" Visibility="Collapsed"/>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,10,0,0"
                   Foreground="{StaticResource TextMuted}" Text="Ready." TextWrapping="Wrap"/>
    </Grid>
</Window>
