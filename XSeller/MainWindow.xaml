<Window x:Class="XSeller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Seller" Height="760" Width="1200"
        MinHeight="600" MinWidth="980"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="X Seller" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="ShopNameText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                <TextBlock x:Name="IndexCountText" Text="0 indexed" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Outstanding  " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DebtText" Text="0 tokens" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Everything-style search -->
        <Grid Grid.Row="1" Height="48" Margin="0,0,0,12">
            <Border Background="{StaticResource BgPanel}" CornerRadius="12" BorderBrush="#2E2E40" BorderThickness="1"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                     FontSize="16" VerticalContentAlignment="Center" Padding="16,0"
                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Text="Search everything — type part of a name or path (space = AND)"
                       Foreground="{StaticResource TextMuted}" FontSize="15"
                       VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- Filters + progress -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="ChipAll" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="{StaticResource Accent}" MouseLeftButtonUp="ChipAll_Click">
                    <TextBlock Text="All" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                </Border>
                <Border x:Name="ChipVideo" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipVideo_Click">
                    <TextBlock Text="Video" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border x:Name="ChipPdf" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipPdf_Click">
                    <TextBlock Text="PDF" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border x:Name="ChipImage" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipImage_Click">
                    <TextBlock Text="Image" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border x:Name="ChipExe" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipExe_Click">
                    <TextBlock Text="Exe" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border x:Name="ChipProtected" Cursor="Hand" CornerRadius="16" Padding="14,6" Margin="0,0,8,0"
                        Background="#2A2A3A" MouseLeftButtonUp="ChipProtected_Click">
                    <TextBlock Text="Protected" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
                <Border Width="1" Background="#2E2E40" Margin="6,2,12,2"/>
                <Border x:Name="ViewDetailsBtn" Cursor="Hand" CornerRadius="16" Padding="12,6" Margin="0,0,6,0"
                        Background="{StaticResource Accent}" MouseLeftButtonUp="ViewDetails_Click" ToolTip="Details list">
                    <TextBlock Text="☰ Details" Foreground="White" FontSize="12"/>
                </Border>
                <Border x:Name="ViewThumbsBtn" Cursor="Hand" CornerRadius="16" Padding="12,6"
                        Background="#2A2A3A" MouseLeftButtonUp="ViewThumbs_Click" ToolTip="Thumbnail grid">
                    <TextBlock Text="▦ Thumbnails" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </Border>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Orientation="Vertical" Visibility="Collapsed" HorizontalAlignment="Right" Width="280">
                <ProgressBar Height="4" IsIndeterminate="True" BorderThickness="0"
                             Background="#2A2A3A" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProgressLabel" Text="Working…" FontSize="11"
                           Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Split -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="2">
                <Grid>
                    <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimary}"
                              SelectionMode="Extended"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              GridViewColumnHeader.Click="ResultsHeader_Click"
                              MouseDoubleClick="ResultsList_MouseDoubleClick"
                              PreviewKeyDown="ResultsList_PreviewKeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" InputGestureText="Ctrl+Enter" Click="MenuOpen_Click"/>
                                <MenuItem Header="Open folder" Click="MenuOpenFolder_Click"/>
                                <MenuItem Header="Copy path" InputGestureText="Ctrl+Shift+C" Click="MenuCopyPath_Click"/>
                                <Separator/>
                                <MenuItem Header="Add to send queue" InputGestureText="Enter" Click="MenuQueue_Click"/>
                                <MenuItem Header="Send to phone" Click="MenuSend_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="300" DisplayMemberBinding="{Binding Name}">
                                    <GridViewColumnHeader Content="Name" Tag="Name"/>
                                </GridViewColumn>
                                <GridViewColumn Width="300" DisplayMemberBinding="{Binding Folder}">
                                    <GridViewColumnHeader Content="Path" Tag="Path"/>
                                </GridViewColumn>
                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding SizeLabel}">
                                    <GridViewColumnHeader Content="Size" Tag="Size"/>
                                </GridViewColumn>
                                <GridViewColumn Width="125" DisplayMemberBinding="{Binding ModifiedLabel}">
                                    <GridViewColumnHeader Content="Date modified" Tag="Modified"/>
                                </GridViewColumn>
                                <GridViewColumn Width="110" DisplayMemberBinding="{Binding TypeLabel}">
                                    <GridViewColumnHeader Content="Type" Tag="Type"/>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListBox x:Name="ThumbGrid" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SizeChanged="ThumbGrid_SizeChanged" PreviewKeyDown="ThumbGrid_PreviewKeyDown" Focusable="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="tile" Width="168" Height="196" Margin="4" CornerRadius="8" Padding="6"
                                                    Background="#1E1E2A" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                                    ToolTip="{Binding FilePath}"
                                                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                                    MouseRightButtonDown="Tile_MouseRightButtonDown">
                                                <DockPanel>
                                                    <TextBlock x:Name="tileName" DockPanel.Dock="Bottom" Text="{Binding Name}" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="12"
                                                               Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0"/>
                                                    <TextBlock x:Name="tileMeta" DockPanel.Dock="Bottom" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}">
                                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding SizeLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Grid Background="#12121A">
                                                        <TextBlock Text="{Binding KindGlyph}" FontSize="44" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tile" Property="Background" Value="#2A3A4D"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="tile" Property="Background" Value="#0078D4"/>
                                                    <Setter TargetName="tile" Property="BorderBrush" Value="#66B3FF"/>
                                                    <Setter TargetName="tileName" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="tileMeta" Property="Foreground" Value="#E6F2FF"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="LibraryEmpty" Text="No matches. Drop .shamm packages into Library or media into indexed folders (video, PDF, image, exe)."
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="40" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="14" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Phones (tick to send)" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Cursor="Hand" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" Text="⟳ Refresh" ToolTip="Restart adb and rescan phones"
                                   MouseLeftButtonUp="RefreshPhones_Click"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock FontSize="11" Cursor="Hand" Foreground="{StaticResource Accent}" Margin="0,0,14,0"
                                   Text="Install phone drivers" ToolTip="Install ADB USB drivers (asks Windows permission)"
                                   MouseLeftButtonUp="InstallDrivers_Click"/>
                        <TextBlock FontSize="11" Cursor="Hand" Foreground="{StaticResource Accent}"
                                   Text="Diagnostics" ToolTip="Copy a phone-detection report to the clipboard and Documents\XSeller\diag.txt"
                                   MouseLeftButtonUp="Diagnostics_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AdbStatusText" DockPanel.Dock="Top" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" Text="adb: starting…"/>
                    <TextBlock x:Name="UsbHintText" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="QueueText" Text="Queue empty · Enter adds selection" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11" Cursor="Hand"
                                       Foreground="{StaticResource Accent}" Text="Clear"
                                       MouseLeftButtonUp="ClearQueue_Click"/>
                        </Grid>
                        <Button Content="Send" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8" Click="Send_Click" x:Name="SendButton"/>
                        <Button Content="Index ticked phone storage" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="IndexPhone_Click"
                                ToolTip="Browse/search the whole phone storage (incl. Android folder) over MTP"/>
                        <Button Content="Copy to USB / folder…" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="CopyUsb_Click"/>
                        <Separator Margin="0,6,0,10" Background="#2A2A3A"/>
                        <TextBlock Text="Settlement" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <Button Content="Export ledger (USB)" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="ExportForAgent_Click"/>
                        <Button Content="Import settlement" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,8" Click="ImportSettlement_Click"/>
                        <Separator Margin="0,6,0,10" Background="#2A2A3A"/>
                        <TextBlock Text="Media folders" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <ListBox x:Name="RootsList" Height="88" Margin="0,0,0,8"
                                 Background="#12121A" BorderBrush="#2A2A3A" BorderThickness="1"
                                 Foreground="{StaticResource TextPrimary}" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <Button Content="Add media folder…" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Margin="0,0,0,6" Click="AddFolder_Click"/>
                        <CheckBox x:Name="ScanEverythingCheck" Content="Scan everything (all drives, hidden + system)"
                                  Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,4"
                                  Click="ScanEverything_Click"/>
                        <CheckBox x:Name="AllDrivesCheck" Content="Index all fixed drives"
                                  Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,0,0,6"
                                  Click="AllDrives_Click"/>
                        <Button Content="Remove selected folder" Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}"
                                Click="RemoveFolder_Click"/>
                    </StackPanel>
                    <Grid>
                        <ItemsControl x:Name="DevicesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E2A" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsReady}"
                                                      Foreground="{StaticResource TextPrimary}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                                        <Run Text="{Binding StateLabel, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Transport, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                            <TextBlock Text="{Binding Hint}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Hint}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ProgressBar Height="4" Margin="0,6,0,0" Maximum="100" Value="{Binding Progress}"
                                                         Background="#2A2A3A" Foreground="{StaticResource Accent}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="DevicesEmpty" VerticalAlignment="Center" Margin="4">
                            <TextBlock Text="Waiting for phone…" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="1. Plug the phone in with a data USB cable&#10;2. Unlock it&#10;3. Pull down notifications › USB › choose “File transfer”&#10;&#10;No USB debugging needed. The phone appears here automatically."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="DeviceBanner" Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Accent}" FontSize="12" Visibility="Collapsed"/>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,10,0,0"
                   Foreground="{StaticResource TextMuted}" Text="Ready." TextWrapping="Wrap"/>
    </Grid>
</Window>
